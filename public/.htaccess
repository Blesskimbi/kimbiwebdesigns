RewriteEngine On
RewriteBase /

# Force non-www (www -> apex), keep this as the first rule
RewriteCond %{HTTP_HOST} ^www\.everythx\.com$ [NC]
RewriteRule ^ https://everythx.com%{REQUEST_URI} [R=301,L]

# Custom 404 page (set /404.html in hPanel → Advanced → Custom error pages if CDN ignores this)
ErrorDocument 404 /404.html

# Pass through real files and directories (includes prerendered /blog/slug/ folders)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Dashboard — SPA shell (blocked in robots.txt)
RewriteRule ^dashboard(/.*)?$ /index.html [L]

# Missing blog/project slug → SPA (BlogPostPage / ProjectDetailPage set noindex)
RewriteRule ^blog/[^/]+/?$ /index.html [L]
RewriteRule ^projects/[^/]+/?$ /index.html [L]

# Unknown paths → prerendered 404 page (noindex; avoids serving homepage shell)
RewriteRule ^ /404.html [L]

# ── Security Headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ── Caching for static assets ─────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpg  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ── Gzip compression ─────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
