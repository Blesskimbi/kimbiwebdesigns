RewriteEngine On
RewriteBase /

# Force non-www first (www CDN may bypass later rules on Hostinger)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Force HTTPS (http -> https)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

ErrorDocument 404 /404.html

# ── WordPress legacy URL cleanup ──────────────────────────────────────────
# Old WordPress post/page/attachment IDs: /?p=123, /?page_id=456
# 301-redirect to homepage (clean URL, no query string)
RewriteCond %{QUERY_STRING} (^|&)(p|page_id|attachment_id)=[0-9]+ [NC]
RewriteRule .* /? [R=301,L]

# Old WordPress taxonomy/feed/search query params: /?cat=5, /?tag=foo, /?feed=rss2, /?s=query
RewriteCond %{QUERY_STRING} (^|&)(cat|tag|author|feed|s)= [NC]
RewriteRule .* /? [R=301,L]

# Pass through real files and directories (prerendered routes are physical folders)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# SPA fallbacks — use REQUEST_URI (more reliable on Hostinger/LiteSpeed)
RewriteCond %{REQUEST_URI} ^/dashboard(/|$) [NC]
RewriteRule ^ /index.html [L]

RewriteCond %{REQUEST_URI} ^/blog/[^/]+/?$ [NC]
RewriteRule ^ /index.html [L]

RewriteCond %{REQUEST_URI} ^/projects/[^/]+/?$ [NC]
RewriteRule ^ /index.html [L]

# All other unmatched paths: Apache returns 404 naturally, triggering ErrorDocument
# above — this serves dist/404.html with a proper HTTP 404 status (not a soft 200)

# ── Security Headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # X-Robots-Tag: tell all crawlers this site is fully indexable
  # (Hostinger CDN may strip this — the HTML <meta name="robots"> is the reliable fallback)
  Header always set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  # Override noindex for dashboard and 404 states
  SetEnvIf Request_URI "^/dashboard(/|$)" NOINDEX=1
  Header always set X-Robots-Tag "noindex, nofollow" env=NOINDEX

  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# ── Caching for static assets ─────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpg  "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css   "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ── Gzip compression ─────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
